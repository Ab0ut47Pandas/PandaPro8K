    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../vendor/HIDMaestro/sdk/HIDMaestro.Core/HIDMaestro.Core.csproj" />
  </ItemGroup>
</Project>
